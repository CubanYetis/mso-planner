# Copy to credentials.env (gitignored) and fill in.
#
# Postgres on donkey, outside the cluster. From a pod, 127.0.0.1 is the pod
# itself, not donkey - use an address of donkey's that pods can reach.
MSO_DB_DSN=postgres://mso:CHANGEME@HOST:5432/mso?sslmode=disable
# Real contact (email or URL) for the User-Agent sent to MSO, Nominatim and
# OSRM - their usage policies require one.
MSO_CONTACT=you@example.com
