# syntax=docker/dockerfile:1

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.22-alpine AS builder

WORKDIR /src

# Download dependencies first (cached layer)
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . .
# geocode-backfill rides along in this image so it can be run as a one-off
# Job (deploy/k8s/backfill-job.yaml) without an image of its own.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/scraper ./cmd/scraper \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/geocode-backfill ./cmd/geocode-backfill

# ── Runtime stage ─────────────────────────────────────────────────────────────
# Distroless: no shell, no package manager — just the binary
FROM gcr.io/distroless/static-debian12

COPY --from=builder /bin/scraper /scraper
COPY --from=builder /bin/geocode-backfill /geocode-backfill

ENTRYPOINT ["/scraper"]
